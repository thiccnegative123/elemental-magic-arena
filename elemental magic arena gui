--// Toggle Button Creator
local function CreateToggleButton(configKey)
    local config = SpammerConfig[configKey]

    local Button = Instance.new("TextButton")
    Button.Name = configKey .. "Toggle"
    Button.Size = UDim2.new(1, 0, 0, 50)
    Button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    Button.BorderSizePixel = 0
    Button.Text = "⛔ " .. config.Name
    Button.TextColor3 = Color3.fromRGB(200, 200, 200)
    Button.TextSize = 16
    Button.Font = Enum.Font.GothamSemibold
    Button.AutoButtonColor = false
    Button.Parent = Container

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = Button

    --// Status Indicator
    local Status = Instance.new("Frame")
    Status.Name = "Status"
    Status.Size = UDim2.new(0, 12, 0, 12)
    Status.Position = UDim2.new(0, 15, 0.5, -6)
    Status.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    Status.BorderSizePixel = 0
    Status.Parent = Button

    local StatusCorner = Instance.new("UICorner")
    StatusCorner.CornerRadius = UDim.new(1, 0)
    StatusCorner.Parent = Status

    --// Click Handler
    Button.MouseButton1Click:Connect(function()
        config.Enabled = not config.Enabled

        if config.Enabled then
            Button.Text = "✅ " .. config.Name
            Button.BackgroundColor3 = config.Color
            Button.TextColor3 = Color3.fromRGB(0, 0, 0)
            Status.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
        else
            Button.Text = "⛔ " .. config.Name
            Button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            Button.TextColor3 = Color3.fromRGB(200, 200, 200)
            Status.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        end
    end)

    --// Hover Effects
    Button.MouseEnter:Connect(function()
        if not config.Enabled then
            TweenService:Create(Button, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(80, 80, 90)
            }):Play()
        end
    end)

    Button.MouseLeave:Connect(function()
        if not config.Enabled then
            TweenService:Create(Button, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            }):Play()
        end
    end)

    return Button
end

